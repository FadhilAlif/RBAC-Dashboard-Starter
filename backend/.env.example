# ============================================================
# RBAC Boilerplate — Environment Variables
# Copy file ini ke .env dan isi dengan nilai lokal Anda
# ============================================================

# Server
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL / NeonDB)
# Opsi 1: Gunakan connection string langsung (direkomendasikan untuk NeonDB):
# DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/rbac_db?sslmode=require
#
# Opsi 2: Konfigurasi per parameter (PostgreSQL lokal):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rbac_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# JWT — gunakan string acak minimal 32 karakter
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your-access-secret-min-32-chars-here-replace-this
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-here-replace-this
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (Resend — https://resend.com)
# Development/Sandbox: Dapatkan API Key di https://resend.com/api-keys
# Jika dikosongkan, pengiriman email otomatis beralih ke mode simulasi (console log)
RESEND_API_KEY=re_your_resend_api_key_here
# Alamat pengirim default untuk testing/onboarding Resend: onboarding@resend.dev
# Untuk domain kustom produksi: noreply@yourdomain.com
RESEND_FROM=onboarding@resend.dev

# Cache (Redis — Opsional)
# Jika tidak diisi, PermissionsCacheService otomatis menggunakan In-Memory Cache (TTL 10m)
# REDIS_URL=redis://localhost:6379

# App
APP_NAME=RBAC App

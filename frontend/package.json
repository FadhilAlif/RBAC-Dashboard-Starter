{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "format": "biome format src/",
    "format:fix": "biome format --write src/",
    "lint": "biome lint --diagnostic-level=error src/",
    "lint:error": "biome lint --diagnostic-level=error src/",
    "lint:error:fix": "biome lint --write --diagnostic-level=error src/",
    "check:error": "biome check --diagnostic-level=error src/",
    "check:error:fix": "biome check --write --diagnostic-level=error src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@hookform/resolvers": "^5.2.2",
